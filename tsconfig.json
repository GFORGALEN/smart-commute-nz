{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "vitest/globals", "node", "google.maps"],
    "paths": {
      "@smart-commute/core": ["./packages/core/src/index.ts"],
      "@smart-commute/providers": ["./packages/providers/src/index.ts"],
      "@smart-commute/react": ["./packages/react/src/index.ts"],
      "@smart-commute/i18n": ["./packages/i18n/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "tests", "*.ts"],
  "exclude": ["node_modules", "dist", "dist-widget"]
}
