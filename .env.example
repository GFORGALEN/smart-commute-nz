# Optional public browser key. Never paste a real key into chat or commit it.
# Restrict by HTTP referrers AND API in Google Cloud Console.
# Leave blank for fully offline manual mode. Enabling billing requires your consent.
VITE_GOOGLE_MAPS_API_KEY=
# Repository deployment path; defaults to / locally and /smart-commute-nz/ in Pages CI.
VITE_BASE_PATH=/
